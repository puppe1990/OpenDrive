# Storage adapter: fake (default) | b2 | s3
# Development uses the fake adapter by default; production defaults to b2.
OPEN_DRIVE_STORAGE_ADAPTER=fake

# --- Backblaze B2 ---------------------------------------------------------
# OPEN_DRIVE_STORAGE_ADAPTER=b2
# B2_BUCKET=your-bucket
# B2_APPLICATION_KEY_ID=replace-me
# B2_APPLICATION_KEY=replace-me
# B2_REGION=us-east-005                       # optional, defaults to us-east-005
# B2_ENDPOINT=s3.us-east-005.backblazeb2.com  # optional, derived from B2_REGION

# --- S3-compatible (AWS S3, MinIO, Ceph, R2, ...) -------------------------
# OPEN_DRIVE_STORAGE_ADAPTER=s3
# AWS_S3_BUCKET=your-bucket
# AWS_ACCESS_KEY_ID=replace-me
# AWS_SECRET_ACCESS_KEY=replace-me
# AWS_REGION=us-east-1
# AWS_S3_HOST=localhost                      # optional custom endpoint
# AWS_S3_PORT=9000
# AWS_S3_SCHEME=http://

# Produção (Turso)
# TURSO_DATABASE_URL=libsql://open-drive-prod-puppe1990.aws-us-east-1.turso.io
# TURSO_AUTH_TOKEN=
